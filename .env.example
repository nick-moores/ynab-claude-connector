# Copy to .env.local for local runs. Never commit real values.

# YNAB Personal Access Token: https://app.ynab.com/settings/developer
YNAB_TOKEN=your-ynab-token

# Random string, at least 32 characters (openssl rand -hex 32). Hosted deploys only.
MCP_SECRET=replace-with-a-long-random-string

# Optional. Defaults to your last-used budget.
YNAB_BUDGET_ID=
